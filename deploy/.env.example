# f126-race-engineer — local deployment configuration.
#
# Copy to deploy/.env and fill in the values for YOUR environment:
#
#     cp deploy/.env.example deploy/.env
#     $EDITOR deploy/.env
#
# deploy/.env is gitignored. Nothing in the tracked tree names a real host, node
# or cluster — the repo is public, the topology is not. The Makefile does
# `-include deploy/.env`, so these become plain make variables; anything here can
# also be overridden per-invocation (`make deploy IMAGE_TAG=sha-abc1234`).
#
# Local-only targets (dev, replay, test, lint, frontend) do NOT need this file.
# Cluster and registry targets (deploy, logs, image, push, db-init) do, and will
# tell you so rather than guessing.
#
# Format: plain `KEY=value`, no `export`, no shell expansion, no quotes needed.

# kubectl context for the cluster you deploy to (`kubectl config get-contexts`).
KUBE_CONTEXT=my-k8s-context

# Kubernetes namespace. The manifests default to f126; change both if you change it.
NAMESPACE=f126

# Public hostname the dashboard is served on. Must match the host in your
# deploy/local overlay (see deploy/k8s/README.md) and have DNS pointing at the
# cluster's ingress. The tracked base manifests use race.example.com as a
# placeholder and are not deployable as-is.
DASHBOARD_HOST=race.example.com

# LAN IP of the cluster node that will receive game telemetry. This is the
# address you type into the console's UDP telemetry settings: the pod binds
# UDP/20777 with hostPort, so packets must be addressed to the NODE, not to a
# Service or the ingress. `kubectl get nodes -o wide` shows it.
NODE_IP=192.0.2.10

# UDP port the game broadcasts telemetry on. 20777 is the F1-series default and
# matches hostPort in deploy/k8s/deployment.yaml — change both together.
UDP_PORT=20777

# Container image repository (no tag). GitHub Actions publishes to
# ghcr.io/<owner>/<repo> automatically; set this to the same path so `make push`
# and `make deploy IMAGE_TAG=...` address the image you actually build.
IMAGE=ghcr.io/EXAMPLE-USER/f126-race-engineer

# --- post-session debrief (optional) -----------------------------------------
# An LLM writes a ~250-word debrief after each session that finishes, from a fact
# sheet the app computes itself. No model is ever in the live loop: if this is
# unset, or the endpoint is down, the only thing that does not happen is a
# paragraph of prose. Nothing about capture, the pit wall or the API changes.
#
# These are read by the *application*, not by make, so they only take effect when
# they reach the pod. Two ways to get them there, both documented in
# deploy/k8s/README.md ("Post-session debrief"):
#   1. create a Secret named f126-llm with keys base_url / model / api_key, or
#   2. append them as env in your gitignored deploy/local overlay.
# The values below are here to document the shape; they are not read at deploy.

# OpenAI-compatible base URL, up to and including the version segment. The client
# appends /chat/completions itself. EMPTY DISABLES THE FEATURE — which is the
# default, and the right default for a fresh clone.
# Note the path: some proxies serve /v1, others mount it under a prefix such as
# /api/v1. Use whatever your endpoint answers /models on.
F126_LLM_BASE_URL=http://llm-proxy.example.svc.cluster.local/api/v1

# Model id, exactly as the endpoint names it. Required: a base URL with no model
# is treated as "disabled" rather than failing one request at a time.
F126_LLM_MODEL=example-model:latest

# Optional bearer token. Omit for an endpoint that does not authenticate; when
# set, prefer a Secret over this file even locally.
F126_LLM_API_KEY=

# Seconds before a generation attempt is abandoned. One retry is made.
F126_LLM_TIMEOUT_S=60

# Seconds to wait after a session closes before reading it back to build the fact
# sheet. The serve path also flushes the DB writer first; this is the margin on
# top, so the final classification and the last laps are certainly committed.
F126_DEBRIEF_DELAY_S=5
